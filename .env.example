# Proveedor activo: openai | anthropic | gemini
LLM_PROVIDER=openai

# Claves de API (completar según el proveedor que uses)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Opcionales
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
